# /etc/despod-m1.env 模板 —— 安装服务时复制为 /etc/despod-m1.env 并填真实值。
# 权限必须 600（chmod 600 /etc/despod-m1.env）。绝不提交真实 key 到仓库。
# 缺省值见 m1_service/config.py；以下均为可选项。

# SiliconFlow（STT 用 SenseVoiceSmall）
SILICONFLOW_API_KEY=your-siliconflow-key
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# DESPOD_M1_STT_MODEL=FunAudioLLM/SenseVoiceSmall

# Agent Gateway（Agnes）
AGNES_API_KEY=your-agnes-key
# AGNES_BASE_URL=https://api.agnes-ai.cn/v1
# DESPOD_M1_AGENT_MODEL=agnes-2.5-flash

# 路径与队列（可选）
# DESPOD_M1_DB_PATH=/root/Desktoppy/data/m1_jobs.db
# DESPOD_M1_AUDIO_ROOT=/tmp
# DESPOD_M1_QUEUE_MAXSIZE=1
# DESPOD_M1_POLL_INTERVAL=0.5
# DESPOD_M1_JOB_TIMEOUT=60
